# =============================================================
# Character Counter Bot — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#   nano .env
#
# NEVER commit .env to git.
# =============================================================

# ── Telegram ──────────────────────────────────────────────────
# Get your token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# ── Webhook (optional) ────────────────────────────────────────
# Set this only if you are deploying to a server with a public URL.
# Leave empty to run in local polling mode (recommended for development).
# Example: https://myapp.onrender.com
WEBHOOK_URL=

# ── Google Sheets Logging (optional) ─────────────────────────
# Leave these empty to disable Sheets logging.
# The bot runs normally without them.

# Spreadsheet ID from the Google Sheets URL:
#   https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=

# Path to your Google Service Account JSON key file.
# Default: google_credentials.json in the same folder as bot.py
GOOGLE_CREDENTIALS_PATH=./google_credentials.json

# ── Server (optional) ─────────────────────────────────────────
# Port to listen on when running in webhook mode.
PORT=8080
