__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.tox/
.venv/
venv/
env/
pip-log.txt

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
._*

# ── Windows ───────────────────────────────────────────────────
Thumbs.db
Desktop.ini

# ── Editor ────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Logs & Runtime ────────────────────────────────────────────
